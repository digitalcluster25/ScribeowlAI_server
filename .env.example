# Скопировать в server/.env и заполнить. server/.env в git не коммитим.
APP_ENV=local
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Supabase (локально: `supabase start`, значения — `supabase status -o env`, см. docs/secrets/supabase-local.md)
# SUPABASE_URL = API_URL
SUPABASE_URL=
# SUPABASE_ANON_KEY = PUBLISHABLE_KEY (sb_publishable_...). Legacy-эквивалент: ANON_KEY (JWT)
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY = SECRET_KEY (sb_secret_...). Legacy-эквивалент: SERVICE_ROLE_KEY (JWT). Только на сервере!
SUPABASE_SERVICE_ROLE_KEY=
# Транскрипт-провайдеры. Порядок фолбэка (id через запятую)
TRANSCRIPT_PROVIDERS_ORDER=youtube_transcript_ai,transcriptapi,supadata,chocodata,easytranscriber
# transcriptapi.com: Authorization: Bearer <key>. Где взять — docs/secrets/transcript-providers.md
TRANSCRIPTAPI_API_KEY=
# Мастер-ключ шифрования ключей провайдеров (AES-256-GCM): base64 от 32 случайных байт.
# Сгенерировать: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIALS_ENCRYPTION_KEY=
# Версия мастер-ключа (для ротации); пишется в provider_credentials.key_version
CREDENTIALS_KEY_VERSION=1
# Запасные ключи сервера (у пользователя может быть свой в профиле → Транскрипты)
SUPADATA_API_KEY=
EASYTRANSCRIBER_API_KEY=
CHOCODATA_API_KEY=
